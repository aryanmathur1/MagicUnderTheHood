---
import '../styles/global.css';
import { site } from '../../config/site.js';

const { title, description, path = '' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
const desc =
  description ||
  `A searchable archive of the ${site.team} interview podcast. Full transcripts, semantic search, and show notes for every episode.`;
const canonical = new URL(path, site.baseUrl).href;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/episodes/', label: 'Episodes' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#5E2C9E" />
    <link rel="icon" href="/team-logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/team-logo.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <img class="logo" src="/team-logo.svg" alt="" width="38" height="38" />
          <span>
            {site.name}
            <small>{site.tagline}</small>
          </span>
        </a>
        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  (item.href === '/' ? current === '/' : current.startsWith(item.href))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          <strong>{site.name}</strong> is the searchable archive of the {site.team} interview
          podcast, built by the team in {site.location}.
        </p>
        <p>
          Every answer and quote on this site comes from our own podcast transcripts.
          Watch the full episodes on our
          <a href={site.channelUrl} rel="noopener">YouTube channel</a>
          or visit <a href={site.brandSiteUrl} rel="noopener">metalmagicftc.org</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
