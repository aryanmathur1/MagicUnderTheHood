---
import '../styles/global.css';
import { site } from '../../config/site.js';

const { title, description, path = '' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
const desc =
  description ||
  `A searchable archive of the ${site.team} interview podcast. Full transcripts, semantic search, and show notes for every episode.`;
const canonical = new URL(path, site.baseUrl).href;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/episodes/', label: 'Episodes' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#110c1a" />
    <link rel="icon" href="/team-logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/team-logo.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Geist:wght@400..700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Runs before paint: marks JS as available (for scroll reveals) and applies
         the saved theme so there is no flash. Dark is the default. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = 'dark';
        try {
          theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
        } catch (e) {}
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-inner">
        <a class="brand" href="/">
          <img src="/team-logo.svg" alt="" width="34" height="34" />
          <span class="brand-name">{site.name}</span>
          <span class="brand-meter" aria-hidden="true"><i></i><i></i><i></i></span>
        </a>
        <nav class="nav-links" aria-label="Primary" data-menu>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  (item.href === '/' ? current === '/' : current.startsWith(item.href))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
          <a class="nav-cta" href={site.channelUrl} rel="noopener">YouTube</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch to light mode" data-theme-toggle>
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path></svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
        </button>
        <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" data-menu-toggle>
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot-grid">
        <div>
          <p class="foot-name">{site.name}</p>
          <p>The FTC interview podcast by {site.team}, {site.location}.</p>
        </div>
        <p>
          Every answer and quote on this site comes from our own episode transcripts and team
          pages, linked back to the source so you can check it.
        </p>
        <div class="foot-links">
          <a href={site.channelUrl} rel="noopener">YouTube channel</a>
          <a href={site.brandSiteUrl} rel="noopener">metalmagicftc.org</a>
          <a href="/about/">About this site</a>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
