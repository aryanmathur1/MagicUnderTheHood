---
import Base from '../layouts/Base.astro';
import Wave from '../components/Wave.astro';
import { site } from '../../config/site.js';
import { speechWaveform } from '../lib/util.js';

const modules = import.meta.glob('../data/episodes/*.json', { eager: true });
const headWave = Object.values(modules).flatMap((m) => speechWaveform(m.default, 50));

const features = [
  ['Full transcripts', 'Every episode, readable and searchable. Good for accessibility and for search engines.'],
  ['Ask the podcast', 'A question in plain English gets an answer stitched together from what teams actually said.'],
  ['Show notes', 'A summary, chapter markers, and pull quotes for each episode.'],
  ['Clip finder', 'The most shareable moments, picked and captioned for Reels and Shorts.'],
];
---

<Base path="/about/" title="About">
  <header class="page-head">
    <Wave values={headWave} class="head-wave" />
    <div class="container">
      <h1>Making our podcast findable</h1>
      <p class="lead">
        {site.team} runs the first FTC interview podcast in the Chesapeake region. The advice was
        great, but it was trapped inside videos. This site sets it free.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container split">
      <div class="copy" data-reveal>
        <h2>Why we built this</h2>
        <p>
          We sit down with other teams and pull out the practical stuff: how they designed a
          mechanism, how they organized their season, and what they’d do differently next time.
        </p>
        <p>
          The catch is that search engines can’t listen to video. So we turned every episode
          into text you can search, read, and link to.
        </p>
      </div>
      <figure class="photo" data-reveal style="--i:1">
        <img
          src="/team.jpg"
          alt="The Metal Magic FTC #23362 team standing with their competition robot and two trophies in their workshop"
          width="1232"
          height="848"
          loading="lazy"
        />
        <figcaption><span class="rec"></span>{site.team}, {site.location}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <h2>What you can do here</h2>
        </div>
      </div>
      <ul class="features">
        {
          features.map(([t, d], i) => (
            <li class="feature panel" data-reveal style={`--i:${i}`}>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="container split top">
      <div class="copy" data-reveal>
        <h2>How we keep it honest</h2>
        <p>The search uses AI, so we built guardrails into every step to keep it accurate and checkable.</p>
      </div>
      <ul class="checks" data-reveal style="--i:1">
        <li><strong>Answers come only from the transcripts.</strong> If the archive doesn’t cover your question, the site says so plainly instead of guessing.</li>
        <li><strong>Every answer shows its sources,</strong> with the episode name and a timestamp link, so you can watch it yourself.</li>
        <li><strong>We quote or clearly paraphrase.</strong> Quotes are checked word for word against the transcript.</li>
        <li><strong>It’s written for students.</strong> The whole archive is kept appropriate for a school audience.</li>
      </ul>
    </div>
  </section>

  <section class="section tight">
    <div class="container split top">
      <div class="copy" data-reveal>
        <h2>How it’s built</h2>
        <p>
          All the heavy lifting (transcription, summaries, chapter markers, clip picks, and the
          search index) happens ahead of time in an offline script and is saved as plain files.
          That keeps the live site fast and nearly free to run.
        </p>
        <p>
          The only live step is answering your question, and that goes through a small secure
          service so our API key is never exposed. The whole pipeline is documented in
          <code>ARCHITECTURE.md</code>.
        </p>
      </div>
      <div class="cta panel" data-reveal style="--i:1">
        <h3>Watch the full episodes</h3>
        <p class="muted">Everything on this site links back to the original videos.</p>
        <div class="button-row">
          <a class="btn btn-primary" href={site.channelUrl} rel="noopener">Our YouTube channel</a>
          <a class="btn btn-ghost" href={site.brandSiteUrl} rel="noopener">metalmagicftc.org</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .tight {
      padding-top: 0;
    }
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(32px, 6vw, 80px);
      align-items: center;
    }
    .split.top {
      align-items: start;
    }
    .copy {
      display: grid;
      gap: 18px;
      justify-items: start;
    }
    .copy p {
      margin: 0;
    }
    .copy p:not(.label) {
      color: var(--muted);
      max-width: 52ch;
    }
    .photo {
      margin: 0;
    }
    .photo img {
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border-radius: var(--r-lg);
      border: 1px solid var(--line);
      transition: transform 400ms var(--ease);
    }
    .photo:hover img {
      transform: scale(1.015);
    }
    .photo figcaption {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 14px;
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--muted);
    }
    .rec {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      animation: rec 1.6s ease-in-out infinite;
    }
    @keyframes rec {
      50% {
        opacity: 0.3;
      }
    }
    .features {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .feature {
      padding: 22px;
      transition: border-color 200ms ease, transform 260ms var(--ease);
    }
    .feature:hover {
      border-color: var(--accent-2);
      transform: translateY(-4px);
    }
    .feature h3 {
      margin-bottom: 8px;
    }
    .feature p {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
    }
    .checks {
      display: grid;
      gap: 10px;
      list-style: none;
      margin: 0;
      padding: 0;
      color: var(--muted);
    }
    .checks li {
      position: relative;
      padding: 16px 18px 16px 48px;
      border: 1px solid var(--line);
      border-radius: var(--r);
      background: var(--panel);
    }
    .checks li::before {
      content: '';
      position: absolute;
      left: 18px;
      top: 1.35em;
      width: 14px;
      height: 8px;
      border-left: 2px solid var(--accent);
      border-bottom: 2px solid var(--accent);
      transform: rotate(-45deg);
    }
    .checks strong {
      color: var(--text);
    }
    .cta {
      display: grid;
      gap: 18px;
      padding: clamp(24px, 4vw, 36px);
      border-radius: var(--r-lg);
    }
    .cta h3 {
      font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    }
    code {
      font-family: var(--mono);
      font-size: 0.88em;
      color: var(--text);
      background: var(--panel-2);
      padding: 0.1rem 0.4rem;
      border-radius: 5px;
    }
    @media (max-width: 900px) {
      .split {
        grid-template-columns: 1fr;
      }
      .features {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 520px) {
      .features {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
