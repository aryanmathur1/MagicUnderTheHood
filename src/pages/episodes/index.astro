---
import Base from '../../layouts/Base.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import Wave from '../../components/Wave.astro';
import { speechWaveform } from '../../lib/util.js';
import manifest from '../../data/manifest.json';

const episodes = manifest;
// Every episode's waveform laid end to end: the whole archive as one recording.
const modules = import.meta.glob('../../data/episodes/*.json', { eager: true });
const archiveWave = Object.values(modules)
  .map((m) => m.default)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
  .flatMap((ep) => speechWaveform(ep, 50));
---

<Base path="/episodes/" title="Episodes">
  <header class="page-head">
    <Wave values={archiveWave} class="head-wave" />
    <div class="container">
      <h1>Episodes</h1>
      <p class="lead">
        Every episode has a full transcript, chapter markers, and shareable clips. Open one to
        watch and read along at the same time.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="filter-bar">
        <label class="filter">
          <span class="visually-hidden">Filter episodes</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input id="ep-filter" type="search" placeholder="Filter by team, number, or topic" autocomplete="off" />
        </label>
        <p class="filter-count" id="ep-count" aria-live="polite">{episodes.length} episodes</p>
      </div>
      <ol class="tracklist" id="ep-list">
        {episodes.map((ep, i) => <EpisodeCard ep={ep} n={i + 1} />)}
      </ol>
      <p class="empty" id="ep-empty" hidden>
        Nothing matches that. Try a team number, or <a href="/#ask">ask the podcast</a> instead.
      </p>
    </div>
  </section>

  <style>
    .filter-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px 20px;
      margin-bottom: 24px;
    }
    .filter {
      position: relative;
      display: flex;
      align-items: center;
      flex: 1 1 320px;
      max-width: 460px;
      color: var(--muted);
    }
    .filter svg {
      position: absolute;
      left: 18px;
      pointer-events: none;
    }
    .filter input {
      width: 100%;
      min-height: 50px;
      padding: 0 18px 0 46px;
      font: inherit;
      color: var(--text);
      background: var(--panel);
      border: 1px solid var(--line-2);
      border-radius: 999px;
    }
    .filter input:focus {
      outline: none;
      border-color: var(--text);
    }
    .filter-count {
      margin: 0;
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--muted);
    }
    .empty {
      margin-top: 24px;
      color: var(--muted);
    }
    .empty a {
      color: var(--text);
    }
  </style>

  <script>
    const input = document.getElementById('ep-filter');
    const items = Array.from(document.querySelectorAll('#ep-list [data-search]'));
    const count = document.getElementById('ep-count');
    const empty = document.getElementById('ep-empty');
    input.addEventListener('input', () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const el of items) {
        const hit = terms.every((t) => el.dataset.search.includes(t));
        el.hidden = !hit;
        if (hit) shown++;
      }
      count.textContent = `${shown} ${shown === 1 ? 'episode' : 'episodes'}`;
      empty.hidden = shown > 0;
    });
  </script>
</Base>
