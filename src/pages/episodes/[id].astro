---
import Base from '../../layouts/Base.astro';
import Wave from '../../components/Wave.astro';
import {
  formatTimestamp,
  youtubeAt,
  humanDuration,
  formatUploadDate,
  teamFromTitle,
  speechWaveform,
} from '../../lib/util.js';

export async function getStaticPaths() {
  // Vite bundles every committed episode JSON at build time. Add an episode by
  // running the pipeline (which writes a new file here); no code change needed.
  const modules = import.meta.glob('../../data/episodes/*.json', { eager: true });
  const eps = Object.values(modules)
    .map((m) => m.default)
    .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
  return eps.map((ep) => ({ params: { id: ep.id }, props: { ep } }));
}

const { ep } = Astro.props;
const team = teamFromTitle(ep.title);
const notes = ep.showNotes;
const clips = ep.clips || [];
const paragraphs = ep.paragraphs || [];
const chapters = notes?.chapters || [];
const quotes = notes?.pullQuotes || [];
const translations = ep.translations || {};
const langs = (ep.languages || []).filter((l) => Array.isArray(translations[l.code]));
const hasTranslations = langs.length > 0;
const duration =
  ep.durationSeconds || (paragraphs.length ? Math.ceil(paragraphs[paragraphs.length - 1].start + 10) : 0);
const pct = (s) => `${Math.min(100, Math.max(0, (s / (duration || 1)) * 100)).toFixed(3)}%`;
const wave = speechWaveform(ep, 120);
const embedBase = `https://www.youtube-nocookie.com/embed/${ep.id}?rel=0&enablejsapi=1&playsinline=1`;
---

<Base path={`/episodes/${ep.id}/`} title={ep.title} description={notes?.summary || ep.description?.slice(0, 155)}>
  <article data-duration={duration}>
    <header class="container ep-head">
      <a class="back" href="/episodes/">All episodes</a>
      <div class="tags">
        {team && <span class="chip">{team}</span>}
        {ep.uploadDate && <span>{formatUploadDate(ep.uploadDate)}</span>}
        {ep.durationSeconds && <span>{humanDuration(ep.durationSeconds)}</span>}
      </div>
      <h1>{ep.title}</h1>
      {notes?.summary && <p class="lead">{notes.summary}</p>}
    </header>

    <div class="container stage">
      <div class="stage-main">
        <div class="player">
          <iframe
            id="player"
            src={embedBase}
            title={`YouTube video player: ${ep.title}`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- Waveform scrubber: click or drag to seek. Chapters are ticks, search hits are dots. -->
        <div class="scrubber panel" id="scrubber" style="--p:0%">
          <div class="scrub-top">
            <span class="scrub-time"><span id="now-time">0:00</span> <span class="dim">/ {formatTimestamp(duration)}</span></span>
            <span class="scrub-chapter" id="now-chapter">{chapters[0]?.title || 'Click anywhere on the waveform to jump'}</span>
          </div>
          <div
            class="scrub-track"
            id="scrub-track"
            role="slider"
            tabindex="0"
            aria-label="Seek through the episode"
            aria-valuemin="0"
            aria-valuemax={duration}
            aria-valuenow="0"
            aria-valuetext="0:00">
            <Wave values={wave} class="scrub-wave" />
            <Wave values={wave} class="scrub-wave scrub-played" />
            {chapters.map((c) => <span class="tick" style={`left:${pct(c.seconds)}`} title={`${c.time} ${c.title}`}></span>)}
            <div class="hits" id="hits"></div>
            <span class="head"></span>
            <span class="hover-line" id="hover-line"></span>
            <div class="tip" id="tip"><span class="ts" id="tip-time"></span><span id="tip-text"></span></div>
          </div>
        </div>

        <div class="tabs" role="tablist" aria-label="Episode content">
          <button role="tab" id="tab-transcript" aria-controls="panel-transcript" aria-selected="true">Transcript</button>
          {quotes.length > 0 && <button role="tab" id="tab-quotes" aria-controls="panel-quotes" aria-selected="false" tabindex="-1">Highlights <span class="count">{quotes.length}</span></button>}
          {clips.length > 0 && <button role="tab" id="tab-clips" aria-controls="panel-clips" aria-selected="false" tabindex="-1">Clips <span class="count">{clips.length}</span></button>}
        </div>

        <section class="tab-panel" role="tabpanel" id="panel-transcript" aria-labelledby="tab-transcript">
          {
            paragraphs.length ? (
              <Fragment>
                <div class="tools">
                  <label class="search">
                    <span class="visually-hidden">Search the transcript</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <input id="t-search" type="search" placeholder="Search this episode" autocomplete="off" />
                    <span class="hit-count" id="hit-count" aria-live="polite"></span>
                    <button type="button" class="hit-nav" id="hit-prev" aria-label="Previous match" disabled>↑</button>
                    <button type="button" class="hit-nav" id="hit-next" aria-label="Next match" disabled>↓</button>
                  </label>
                  <label class="follow">
                    <input type="checkbox" id="follow" checked />
                    <span class="switch" aria-hidden="true"><span></span></span>
                    Follow along
                  </label>
                  {hasTranslations && (
                    <label class="lang">
                      <span class="visually-hidden">Transcript language</span>
                      <select id="lang-select">
                        <option value="en" selected>English</option>
                        {langs.map((l) => (
                          <option value={l.code}>{l.label}</option>
                        ))}
                      </select>
                    </label>
                  )}
                </div>
                <div class="transcript" id="transcript" lang="en" dir="ltr">
                  {paragraphs.map((p, i) => (
                    <p class="tp" data-i={i} data-start={p.start}>
                      <a
                        class="ts"
                        href={youtubeAt(ep.id, p.start)}
                        data-seconds={Math.floor(p.start)}
                        aria-label={`Play from ${formatTimestamp(p.start)}`}
                      >
                        {formatTimestamp(p.start)}
                      </a>
                      <span class="tp-text" data-original={p.text}>{p.text}</span>
                    </p>
                  ))}
                </div>
                <p class="transcript-note" id="transcript-note">
                  Auto-generated from the episode captions. Click a timestamp to jump there.
                </p>
                {hasTranslations && (
                  <Fragment>
                    <script type="application/json" id="translations-data" set:html={JSON.stringify(translations)} />
                    <script type="application/json" id="lang-dirs" set:html={JSON.stringify(Object.fromEntries(langs.map((l) => [l.code, l.dir || 'ltr'])))} />
                  </Fragment>
                )}
              </Fragment>
            ) : (
              <p class="muted">
                A transcript for this episode is being generated. Check back soon, or watch on{' '}
                <a href={ep.url} rel="noopener">YouTube</a>.
              </p>
            )
          }
        </section>

        {
          quotes.length > 0 && (
            <section class="tab-panel" role="tabpanel" id="panel-quotes" aria-labelledby="tab-quotes" hidden>
              <div class="quotes">
                {quotes.map((q) => (
                  <figure class="quote">
                    <blockquote>“{q.quote}”</blockquote>
                    <figcaption>
                      <a class="ts" href={youtubeAt(ep.id, q.seconds)} data-seconds={q.seconds}>
                        ▶ {q.time}
                      </a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        {
          clips.length > 0 && (
            <section class="tab-panel" role="tabpanel" id="panel-clips" aria-labelledby="tab-clips" hidden>
              <p class="muted small">The best moments for Reels and Shorts, with captions ready to post.</p>
              <ul class="clips">
                {clips.map((clip, i) => (
                  <li class="clip panel">
                    <div class="clip-range" aria-hidden="true">
                      <span style={`left:${pct(clip.startSeconds)};width:${pct((clip.endSeconds || clip.startSeconds + 30) - clip.startSeconds)}`} />
                    </div>
                    <div class="clip-head">
                      <a class="ts" href={youtubeAt(ep.id, clip.startSeconds)} data-seconds={clip.startSeconds}>
                        ▶ {clip.start} to {clip.end}
                      </a>
                      <button class="btn btn-ghost btn-sm copy-btn" data-copy-target={`cap-${i}`}>Copy caption</button>
                    </div>
                    <p class="clip-reason">{clip.reason}</p>
                    <p class="clip-caption" id={`cap-${i}`}>{clip.caption}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="side">
        {
          chapters.length > 0 && (
            <div class="side-block">
              <h2 class="side-title">Chapters</h2>
              <ol class="chapters" id="chapters">
                {chapters.map((c, i) => (
                  <li>
                    <a
                      class="chapter"
                      href={youtubeAt(ep.id, c.seconds)}
                      data-seconds={c.seconds}
                      data-end={chapters[i + 1]?.seconds ?? duration}
                    >
                      <span class="ts">{c.time}</span>
                      <span class="chapter-title">{c.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        {
          notes?.youtubeChapterBlock && (
            <details class="side-block copy-block">
              <summary class="side-title">YouTube chapters</summary>
              <p class="muted small">Copy and paste into a video description.</p>
              <pre class="copyblock" id="chapterblock">{notes.youtubeChapterBlock}</pre>
              <button class="btn btn-ghost btn-sm copy-btn" data-copy-target="chapterblock">Copy chapters</button>
            </details>
          )
        }

        {
          !notes && (
            <div class="side-block">
              <h2 class="side-title">Show notes coming soon</h2>
              <p class="muted small">
                Summary, chapters, highlights, and clips are generated by the build pipeline. Run
                <code>npm run regenerate</code> with an API key set to fill these in.
              </p>
            </div>
          )
        }

        <a class="btn btn-primary yt" href={ep.url} rel="noopener">Watch on YouTube</a>
      </aside>
    </div>
  </article>

  <style>
    .ep-head {
      display: grid;
      gap: 18px;
      justify-items: start;
      padding-block: clamp(32px, 5vw, 56px) clamp(24px, 4vw, 40px);
    }
    .back {
      font-size: 0.92rem;
      color: var(--muted);
      text-decoration: none;
    }
    .back::before {
      content: '\2190  ';
      color: var(--accent);
    }
    .back:hover {
      color: var(--text);
    }
    .tags {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 14px;
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--muted);
    }
    .ep-head h1 {
      max-width: 22ch;
      font-size: clamp(2rem, 4.6vw, 3.6rem);
      letter-spacing: -0.035em;
    }
    .ep-head .lead {
      margin: 0;
    }

    .stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: clamp(24px, 3vw, 40px);
      align-items: start;
    }
    .player {
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: var(--r-lg);
      border: 1px solid var(--line);
      background: #000;
    }
    .player iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* ---------- scrubber ---------- */
    .scrubber {
      margin-top: 12px;
      padding: 14px 18px 18px;
      border-radius: var(--r-lg);
    }
    .scrub-top {
      display: flex;
      align-items: baseline;
      gap: 16px;
      margin-bottom: 10px;
      font-family: var(--mono);
      font-size: 0.82rem;
    }
    .scrub-time {
      font-variant-numeric: tabular-nums;
      color: var(--text);
      white-space: nowrap;
    }
    .dim {
      color: var(--dim);
    }
    .scrub-chapter {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--accent-2);
    }
    .scrub-track {
      position: relative;
      height: 56px;
      cursor: pointer;
      touch-action: none;
      border-radius: 6px;
    }
    .scrub-track :global(.scrub-wave) {
      position: absolute;
      inset: 0;
      height: 100%;
      gap: 2px;
    }
    .scrub-track :global(.scrub-played) {
      clip-path: inset(0 calc(100% - var(--p)) 0 0);
    }
    .scrub-track :global(.scrub-played i) {
      background: var(--accent-2);
    }
    .tick {
      position: absolute;
      top: -6px;
      bottom: -6px;
      width: 1px;
      background: var(--muted);
      opacity: 0.45;
    }
    .tick::before {
      content: '';
      position: absolute;
      top: 0;
      left: -3px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--muted);
    }
    .head {
      position: absolute;
      top: -8px;
      bottom: -8px;
      left: var(--p);
      width: 2px;
      margin-left: -1px;
      border-radius: 1px;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
      pointer-events: none;
    }
    .hover-line {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--text);
      opacity: 0;
      pointer-events: none;
    }
    .hits :global(.hit) {
      position: absolute;
      bottom: -12px;
      width: 6px;
      height: 6px;
      margin-left: -3px;
      border-radius: 50%;
      background: var(--focus);
      pointer-events: none;
    }
    .tip {
      position: absolute;
      bottom: calc(100% + 14px);
      z-index: 5;
      display: grid;
      gap: 4px;
      width: 260px;
      padding: 10px 12px;
      border: 1px solid var(--line-2);
      border-radius: var(--r);
      background: var(--panel-2);
      font-size: 0.85rem;
      line-height: 1.4;
      color: var(--muted);
      opacity: 0;
      transform: translate(-50%, 4px);
      transition: opacity 120ms ease, transform 160ms var(--ease);
      pointer-events: none;
    }
    .scrub-track.hovering .tip {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    .scrub-track.hovering .hover-line {
      opacity: 0.5;
    }

    /* ---------- tabs ---------- */
    .tabs {
      display: flex;
      gap: 6px;
      margin: 28px 0 18px;
      padding: 5px;
      width: fit-content;
      max-width: 100%;
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--panel);
    }
    .tabs button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      font: inherit;
      font-size: 0.94rem;
      font-weight: 500;
      color: var(--muted);
      cursor: pointer;
      white-space: nowrap;
      transition: background-color 160ms ease, color 160ms ease;
    }
    .tabs button:hover {
      color: var(--text);
    }
    .tabs button[aria-selected='true'] {
      box-shadow: inset 0 0 0 1.5px var(--accent);
      background: var(--accent-soft);
      color: var(--accent);
    }
    .count {
      font-family: var(--mono);
      font-size: 0.75rem;
      opacity: 0.7;
    }
    .tab-panel {
      animation: vt-in 300ms var(--ease) both;
    }

    /* ---------- transcript ---------- */
    .tools {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 18px;
      margin-bottom: 12px;
    }
    .search {
      position: relative;
      display: flex;
      align-items: center;
      gap: 6px;
      flex: 1 1 280px;
      padding: 0 6px 0 14px;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      background: var(--panel);
      color: var(--muted);
    }
    .search:focus-within {
      border-color: var(--text);
    }
    .search input {
      flex: 1;
      min-width: 0;
      min-height: 42px;
      border: 0;
      background: transparent;
      font: inherit;
      font-size: 0.95rem;
      color: var(--text);
    }
    .search input:focus {
      outline: none;
    }
    .hit-count {
      font-family: var(--mono);
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .hit-nav {
      width: 30px;
      height: 30px;
      border: 0;
      border-radius: 50%;
      background: var(--panel-2);
      color: var(--text);
      cursor: pointer;
    }
    .hit-nav:disabled {
      opacity: 0.35;
      cursor: default;
    }
    .follow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 0.9rem;
      color: var(--muted);
      cursor: pointer;
      user-select: none;
    }
    .follow input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .switch {
      position: relative;
      width: 36px;
      height: 20px;
      border-radius: 999px;
      background: var(--line-2);
      transition: background-color 180ms ease;
    }
    .switch span {
      position: absolute;
      top: 3px;
      left: 3px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #fff;
      transition: transform 200ms var(--ease);
    }
    .follow input:checked + .switch {
      background: var(--accent);
    }
    .follow input:checked + .switch span {
      transform: translateX(16px);
    }
    .follow input:focus-visible + .switch {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }
    .lang select {
      min-height: 42px;
      padding: 0 14px;
      border: 1px solid var(--line-2);
      border-radius: 999px;
      background: var(--panel);
      font: inherit;
      font-size: 0.9rem;
      color: var(--text);
      cursor: pointer;
    }

    .transcript {
      position: relative;
      max-height: min(70vh, 640px);
      overflow-y: auto;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      background: var(--panel);
      scrollbar-color: var(--line-2) transparent;
    }
    .tp {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 14px;
      align-items: baseline;
      margin: 0;
      padding: 12px 14px;
      border-radius: var(--r);
      color: var(--muted);
      transition: background-color 250ms ease, color 250ms ease;
    }
    .tp:hover {
      background: var(--panel-2);
      color: var(--text);
    }
    .tp.now {
      background: var(--accent-soft);
      color: var(--text);
    }
    .tp.now .ts {
      color: var(--accent);
    }
    .transcript[dir='rtl'] .tp {
      grid-template-columns: 1fr 56px;
      text-align: right;
    }
    .tp :global(mark) {
      padding: 0 2px;
      border-radius: 3px;
      background: var(--mark);
      color: var(--text);
    }
    .tp :global(mark.cur) {
      background: var(--focus);
      color: var(--bg);
    }
    .transcript-note {
      margin: 12px 4px 0;
      font-size: 0.85rem;
      color: var(--dim);
    }

    /* ---------- highlights + clips ---------- */
    .quotes {
      display: grid;
      gap: 28px;
    }
    .quote {
      margin: 0;
      padding-left: 22px;
      border-left: 3px solid var(--accent-2);
    }
    .quote blockquote {
      margin: 0 0 10px;
      font-family: var(--display);
      font-weight: 500;
      font-size: clamp(1.3rem, 2.4vw, 1.7rem);
      line-height: 1.3;
      letter-spacing: -0.02em;
    }
    .clips {
      display: grid;
      gap: 12px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .clip {
      padding: 18px 20px;
    }
    /* Where in the episode this clip sits. */
    .clip-range {
      position: relative;
      height: 4px;
      margin-bottom: 14px;
      border-radius: 2px;
      background: var(--line-2);
    }
    .clip-range span {
      position: absolute;
      top: -1px;
      bottom: -1px;
      min-width: 6px;
      border-radius: 3px;
      background: var(--accent);
    }
    .clip-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .clip-reason {
      margin: 0 0 10px;
      color: var(--text);
    }
    .clip-caption {
      margin: 0;
      padding: 10px 14px;
      border: 1px dashed var(--line-2);
      border-radius: var(--r);
      font-size: 0.92rem;
      color: var(--muted);
    }
    .small {
      font-size: 0.88rem;
    }

    /* ---------- sidebar ---------- */
    .side {
      position: sticky;
      top: 86px;
      display: grid;
      gap: 16px;
    }
    .side-block {
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      background: var(--panel);
    }
    .side-title {
      margin: 0 0 10px;
      font-family: var(--display);
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .copy-block summary {
      margin: 0;
      cursor: pointer;
      list-style: none;
    }
    .copy-block summary::-webkit-details-marker {
      display: none;
    }
    .copy-block summary::after {
      content: ' +';
      color: var(--accent);
    }
    .copy-block[open] summary::after {
      content: ' \2212';
    }
    .copy-block[open] summary {
      margin-bottom: 10px;
    }
    .chapters {
      display: grid;
      gap: 2px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .chapter {
      position: relative;
      display: grid;
      grid-template-columns: 46px 1fr;
      gap: 10px;
      align-items: baseline;
      overflow: hidden;
      padding: 9px 10px;
      border-radius: var(--r-sm);
      font-size: 0.94rem;
      line-height: 1.35;
      color: var(--muted);
      text-decoration: none;
      transition: background-color 160ms ease, color 160ms ease;
    }
    .chapter:hover {
      background: var(--panel-2);
      color: var(--text);
    }
    /* Active chapter fills up as it plays. */
    .chapter::before {
      content: '';
      position: absolute;
      inset: 0;
      width: var(--cp, 0%);
      background: var(--accent-soft);
      opacity: 0;
      transition: opacity 200ms ease;
    }
    .chapter.now {
      color: var(--text);
    }
    .chapter.now::before {
      opacity: 1;
    }
    .chapter.now .ts {
      color: var(--accent);
    }
    .chapter > * {
      position: relative;
    }
    .copyblock {
      margin: 0 0 12px;
      padding: 12px;
      overflow-x: auto;
      border-radius: var(--r-sm);
      background: var(--bg);
      font-family: var(--mono);
      font-size: 0.78rem;
      line-height: 1.7;
      white-space: pre;
    }
    .yt {
      width: 100%;
    }
    code {
      font-family: var(--mono);
      font-size: 0.88em;
      background: var(--panel-2);
      padding: 0.1rem 0.35rem;
      border-radius: 5px;
    }

    @media (max-width: 960px) {
      .stage {
        grid-template-columns: minmax(0, 1fr);
      }
      .side {
        position: static;
      }
      .tp {
        grid-template-columns: 46px 1fr;
        gap: 10px;
        padding: 10px;
      }
    }
  </style>

  <script>
    const article = document.querySelector('article[data-duration]');
    const duration = Number(article.dataset.duration) || 1;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (t) => {
      t = Math.max(0, Math.floor(t));
      const h = Math.floor(t / 3600);
      const m = Math.floor(t / 60) % 60;
      const s = String(t % 60).padStart(2, '0');
      return h ? `${h}:${String(m).padStart(2, '0')}:${s}` : `${m}:${s}`;
    };

    const iframe = document.getElementById('player');
    const baseSrc = iframe.getAttribute('src');
    const scrubber = document.getElementById('scrubber');
    const track = document.getElementById('scrub-track');
    const nowTime = document.getElementById('now-time');
    const nowChapter = document.getElementById('now-chapter');
    const box = document.getElementById('transcript');
    const paras = Array.from(document.querySelectorAll('.tp'));
    const starts = paras.map((p) => Number(p.dataset.start));
    const chapterLinks = Array.from(document.querySelectorAll('.chapter'));
    const follow = document.getElementById('follow');

    // ---------- player (YouTube IFrame API, with a plain-iframe fallback) ----------
    let yt = null;
    let ytReady = false;
    let poll = 0;

    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.append(tag);
    window.onYouTubeIframeAPIReady = () => {
      yt = new window.YT.Player('player', {
        events: {
          onReady: () => (ytReady = true),
          onStateChange: (e) => {
            clearInterval(poll);
            if (e.data === window.YT.PlayerState.PLAYING) {
              poll = setInterval(() => update(yt.getCurrentTime()), 250);
            }
            update(yt.getCurrentTime());
          },
        },
      });
    };

    function seek(secs) {
      secs = Math.max(0, Math.min(duration, secs));
      if (ytReady) {
        yt.seekTo(secs, true);
        yt.playVideo();
      } else {
        // API not available (blocked, offline): reload the embed at that time.
        iframe.setAttribute('src', `${baseSrc}&start=${Math.floor(secs)}&autoplay=1`);
      }
      update(secs, true);
      const r = iframe.getBoundingClientRect();
      if (r.bottom < 80 || r.top > window.innerHeight) {
        iframe.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      }
    }

    // Any link with data-seconds (timestamps, chapters, quotes, clips) seeks in place.
    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[data-seconds]');
      if (!a) return;
      const secs = Number(a.dataset.seconds);
      if (Number.isNaN(secs)) return;
      e.preventDefault();
      seek(secs);
    });

    // ---------- syncing everything to the current time ----------
    const indexAt = (list, t) => {
      let i = -1;
      for (let k = 0; k < list.length && list[k] <= t + 0.25; k++) i = k;
      return i;
    };
    let activePara = -1;
    let userScrolledAt = 0;
    box?.addEventListener('wheel', () => (userScrolledAt = Date.now()), { passive: true });
    box?.addEventListener('touchmove', () => (userScrolledAt = Date.now()), { passive: true });

    function update(t, jumped = false) {
      const p = `${Math.min(100, (t / duration) * 100).toFixed(3)}%`;
      scrubber.style.setProperty('--p', p);
      nowTime.textContent = fmt(t);
      track.setAttribute('aria-valuenow', String(Math.floor(t)));
      track.setAttribute('aria-valuetext', fmt(t));

      // Chapters: highlight the current one and fill it as it plays.
      chapterLinks.forEach((c) => {
        const s = Number(c.dataset.seconds);
        const end = Number(c.dataset.end);
        const on = t >= s && t < end;
        c.classList.toggle('now', on);
        if (on) {
          c.style.setProperty('--cp', `${(((t - s) / (end - s)) * 100).toFixed(1)}%`);
          nowChapter.textContent = c.querySelector('.chapter-title').textContent;
        }
      });

      // Transcript: highlight the paragraph being spoken, and keep it in view.
      const i = indexAt(starts, t);
      if (i !== activePara) {
        paras[activePara]?.classList.remove('now');
        activePara = i;
        const el = paras[i];
        if (el) {
          el.classList.add('now');
          const idle = Date.now() - userScrolledAt > 4000;
          if (box && follow?.checked && (idle || jumped)) {
            box.scrollTo({
              top: el.offsetTop - box.clientHeight * 0.3,
              behavior: reduceMotion ? 'auto' : 'smooth',
            });
          }
        }
      }
    }

    // ---------- scrubber: click, drag, hover preview, keyboard ----------
    const tip = document.getElementById('tip');
    const tipTime = document.getElementById('tip-time');
    const tipText = document.getElementById('tip-text');
    const hoverLine = document.getElementById('hover-line');
    const timeAt = (clientX) => {
      const r = track.getBoundingClientRect();
      return Math.max(0, Math.min(1, (clientX - r.left) / r.width)) * duration;
    };
    let dragging = false;
    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      track.setPointerCapture(e.pointerId);
      update(timeAt(e.clientX));
    });
    track.addEventListener('pointermove', (e) => {
      const t = timeAt(e.clientX);
      if (dragging) update(t);
      const r = track.getBoundingClientRect();
      const x = e.clientX - r.left;
      track.classList.add('hovering');
      hoverLine.style.left = `${x}px`;
      // Keep the tooltip inside the track.
      tip.style.left = `${Math.max(130, Math.min(r.width - 130, x))}px`;
      tipTime.textContent = fmt(t);
      const i = indexAt(starts, t);
      const text = paras[i]?.querySelector('.tp-text')?.textContent || '';
      tipText.textContent = text.length > 110 ? text.slice(0, 110) + '…' : text;
    });
    track.addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      seek(timeAt(e.clientX));
    });
    track.addEventListener('pointerleave', () => track.classList.remove('hovering'));
    track.addEventListener('keydown', (e) => {
      const cur = Number(track.getAttribute('aria-valuenow')) || 0;
      const step = { ArrowRight: 5, ArrowUp: 5, ArrowLeft: -5, ArrowDown: -5 }[e.key];
      if (step) seek(cur + step);
      else if (e.key === 'Home') seek(0);
      else if (e.key === 'End') seek(duration - 1);
      else return;
      e.preventDefault();
    });

    // ---------- tabs ----------
    const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
    const select = (tab) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const d = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });

    // ---------- transcript search ----------
    const search = document.getElementById('t-search');
    const hitCount = document.getElementById('hit-count');
    const prevBtn = document.getElementById('hit-prev');
    const nextBtn = document.getElementById('hit-next');
    const hitsLayer = document.getElementById('hits');
    const spans = Array.from(document.querySelectorAll('.tp-text'));
    const escHtml = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const escRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    let marks = [];
    let cur = -1;

    function runSearch() {
      const q = search?.value.trim() || '';
      const re = q.length >= 2 ? new RegExp(escRe(q), 'gi') : null;
      hitsLayer.innerHTML = '';
      spans.forEach((span, i) => {
        const text = span.textContent;
        if (!re || !re.test(text)) {
          span.textContent = text;
          return;
        }
        re.lastIndex = 0;
        // Split the raw text on the query (odd parts are matches), then escape each part.
        span.innerHTML = text
          .split(new RegExp(`(${escRe(q)})`, 'gi'))
          .map((part, k) => (k % 2 ? `<mark>${escHtml(part)}</mark>` : escHtml(part)))
          .join('');
        const dot = document.createElement('span');
        dot.className = 'hit';
        dot.style.left = `${(starts[i] / duration) * 100}%`;
        hitsLayer.append(dot);
      });
      marks = Array.from(box?.querySelectorAll('mark') || []);
      cur = -1;
      if (!search) return;
      hitCount.textContent = re ? `${marks.length} ${marks.length === 1 ? 'match' : 'matches'}` : '';
      prevBtn.disabled = nextBtn.disabled = marks.length === 0;
      if (marks.length) go(0);
    }
    function go(i) {
      marks[cur]?.classList.remove('cur');
      cur = (i + marks.length) % marks.length;
      const m = marks[cur];
      m.classList.add('cur');
      hitCount.textContent = `${cur + 1} of ${marks.length}`;
      userScrolledAt = Date.now();
      box.scrollTo({ top: m.closest('.tp').offsetTop - box.clientHeight * 0.3, behavior: reduceMotion ? 'auto' : 'smooth' });
    }
    search?.addEventListener('input', runSearch);
    search?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && marks.length) {
        e.preventDefault();
        go(cur + (e.shiftKey ? -1 : 1));
      }
    });
    prevBtn?.addEventListener('click', () => go(cur - 1));
    nextBtn?.addEventListener('click', () => go(cur + 1));

    // ---------- translation ----------
    // All translations are pre-built and embedded as JSON, so switching is
    // instant. Timestamps and links are untouched.
    const langSelect = document.getElementById('lang-select');
    if (langSelect) {
      const translations = JSON.parse(document.getElementById('translations-data')?.textContent || '{}');
      const dirs = JSON.parse(document.getElementById('lang-dirs')?.textContent || '{}');
      const note = document.getElementById('transcript-note');
      const applyLang = (code) => {
        const rows = translations[code];
        spans.forEach((span, i) => {
          span.textContent = code === 'en' || !rows || rows[i] == null ? span.dataset.original : rows[i];
        });
        box.setAttribute('lang', code);
        box.setAttribute('dir', code === 'en' ? 'ltr' : dirs[code] || 'ltr');
        note.textContent =
          code === 'en'
            ? 'Auto-generated from the episode captions. Click a timestamp to jump there.'
            : 'Machine-translated from the English captions. Click a timestamp to jump there.';
        runSearch();
      };
      langSelect.addEventListener('change', () => applyLang(langSelect.value));
      // Deep link: /episodes/ID/?lang=es opens already translated.
      const wanted = new URLSearchParams(location.search).get('lang');
      if (wanted && (wanted === 'en' || translations[wanted])) {
        langSelect.value = wanted;
        applyLang(wanted);
      }
    }

    // ---------- copy buttons ----------
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const target = document.getElementById(btn.dataset.copyTarget);
        if (!target) return;
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(target.innerText.trim());
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Press Ctrl+C';
        }
        setTimeout(() => (btn.textContent = original), 1600);
      });
    });

    update(0);
  </script>
</Base>
