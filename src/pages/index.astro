---
import Base from '../layouts/Base.astro';
import AskPodcast from '../components/AskPodcast.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { site } from '../../config/site.js';
import manifest from '../data/manifest.json';

const episodes = manifest;
const featured = episodes.slice(0, 3);
---

<Base path="/">
  <section class="hero section">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-top">
        <div class="hero-copy">
          <p class="eyebrow reveal">{site.team} · {site.location}</p>
          <h1 class="reveal">
            Every episode of our robotics podcast, finally
            <span class="grad-text">searchable</span>.
          </h1>
          <p class="lede reveal-2">
            {site.name} is a searchable archive of the first FTC interview podcast in the
            Chesapeake region. Ask a question in plain English and get an answer built only
            from what teams actually said, linked to the exact moment on YouTube.
          </p>
        </div>

        <figure class="hero-photo reveal-2">
          <img
            src="/team-cutout.png"
            alt="The Metal Magic FTC #23362 team with their competition robot and two trophies"
            width="1178"
            height="848"
            onerror="this.closest('.hero-photo').style.display='none'"
          />
        </figure>
      </div>

      <div class="hero-ask reveal-3">
        <AskPodcast autofocus={true} />
      </div>

      <p class="hero-note reveal-3">
        Answers come only from our {episodes.length} episode transcripts and our team pages.
        When the archive doesn’t cover something, it says so instead of guessing.
      </p>
    </div>
  </section>

  <section class="section featured">
    <div class="container">
      <div class="sec-head">
        <div>
          <p class="eyebrow">The archive</p>
          <h2>Browse the episodes</h2>
        </div>
        <a class="btn btn-ghost" href="/episodes/">All episodes →</a>
      </div>
      <div class="grid">
        {featured.map((ep) => <EpisodeCard ep={ep} />)}
      </div>
    </div>
  </section>

  <section class="section how">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Built for teams who need answers fast</h2>
      <div class="how-grid">
        <div class="how-card card">
          <span class="how-num">1</span>
          <h3>Full transcripts</h3>
          <p>
            Every episode has a complete, timestamped transcript. Read it on the page or
            jump straight to any moment on YouTube.
          </p>
        </div>
        <div class="how-card card">
          <span class="how-num">2</span>
          <h3>Ask the podcast</h3>
          <p>
            Semantic search across all episodes. Get a synthesized answer with the exact
            quotes and timestamps it came from.
          </p>
        </div>
        <div class="how-card card">
          <span class="how-num">3</span>
          <h3>Show notes & clips</h3>
          <p>
            Auto-generated summaries, chapter markers, pull quotes, and the most shareable
            moments, ready to post.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero {
      position: relative;
      padding-bottom: 1rem;
      overflow: hidden;
    }
    .hero-glow {
      position: absolute;
      inset: -20% -10% auto -10%;
      height: 620px;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(42% 55% at 78% 12%, rgba(157, 92, 240, 0.18), transparent 70%),
        radial-gradient(38% 50% at 12% 0%, rgba(94, 44, 158, 0.14), transparent 70%);
    }
    .hero .container {
      position: relative;
      z-index: 1;
    }
    .hero-top {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: center;
    }
    .hero h1 {
      max-width: 16ch;
    }
    .hero-copy .lede {
      margin-bottom: 0;
    }

    /* Floating team cutout (transparent PNG) over a soft gradient glow. */
    .hero-photo {
      position: relative;
      margin: 0;
      justify-self: end;
      max-width: 560px;
      width: 100%;
    }
    /* Glowing disc behind the cutout. */
    .hero-photo::before {
      content: '';
      position: absolute;
      inset: 2% -6% 8% -6%;
      z-index: 0;
      border-radius: 50%;
      background: radial-gradient(52% 52% at 50% 45%, rgba(123, 63, 208, 0.35), rgba(123, 63, 208, 0.12) 55%, transparent 72%);
      filter: blur(10px);
      animation: pulse 7s ease-in-out infinite;
    }
    /* Soft ground shadow so the cutout feels planted, not pasted. */
    .hero-photo::after {
      content: '';
      position: absolute;
      left: 12%;
      right: 12%;
      bottom: -1%;
      height: 26px;
      z-index: 0;
      background: radial-gradient(50% 100% at 50% 0%, rgba(28, 24, 48, 0.22), transparent 72%);
      filter: blur(3px);
      animation: floaty 6s ease-in-out infinite;
    }
    .hero-photo img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: auto;
      display: block;
      filter: drop-shadow(0 22px 26px rgba(28, 24, 48, 0.22));
      animation: floaty 6s ease-in-out infinite;
    }
    @keyframes floaty {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.85; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.04); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-photo img,
      .hero-photo::before,
      .hero-photo::after { animation: none; }
    }

    .hero-ask {
      margin-top: 2.5rem;
    }
    .hero-note {
      margin-top: 1rem;
      color: var(--gray);
      font-size: 0.92rem;
    }
    .sec-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .sec-head h2 {
      margin: 0;
    }
    .how-grid {
      display: grid;
      gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      margin-top: 1.5rem;
    }
    .how-card {
      padding: 1.6rem;
    }
    .how-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
      border-color: var(--purple-100);
    }
    .how-num {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 13px;
      background: var(--grad);
      color: #fff;
      font-family: var(--font-head);
      font-weight: 700;
      margin-bottom: 0.9rem;
      box-shadow: 0 6px 14px -5px rgba(94, 44, 158, 0.5);
    }
    .how-card h3 {
      margin-bottom: 0.4rem;
    }
    .how-card p {
      color: var(--ink-soft);
      margin: 0;
      font-size: 0.96rem;
    }
    .featured {
      background: var(--bg-soft);
      border-block: 1px solid var(--line);
    }
    @media (max-width: 860px) {
      .hero-top {
        grid-template-columns: 1fr;
      }
      .hero h1 {
        max-width: 22ch;
      }
      .hero-photo {
        justify-self: center;
        max-width: 440px;
        margin-top: 0.5rem;
      }
    }
  </style>
</Base>
