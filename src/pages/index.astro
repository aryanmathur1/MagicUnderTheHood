---
import Base from '../layouts/Base.astro';
import AskPodcast from '../components/AskPodcast.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import Wave from '../components/Wave.astro';
import { site, languages } from '../../config/site.js';
import { speechWaveform, humanDuration, teamFromTitle } from '../lib/util.js';
import manifest from '../data/manifest.json';

const episodes = manifest;
const featured = episodes.slice(0, 3);

// Real numbers for the readouts, counted from the archive at build time.
const modules = import.meta.glob('../data/episodes/*.json', { eager: true });
const full = Object.values(modules).map((m) => m.default);
const words = full.reduce(
  (sum, ep) => sum + (ep.paragraphs || []).reduce((n, p) => n + p.text.split(/\s+/).filter(Boolean).length, 0),
  0
);
const minutes = Math.round(episodes.reduce((s, e) => s + (e.durationSeconds || 0), 0) / 60);
const readouts = [
  { value: episodes.length, label: 'Episodes' },
  { value: minutes, label: 'Minutes recorded' },
  { value: words, label: 'Words searchable' },
  { value: languages.length + 1, label: 'Languages' },
];

// Newest episode for the "now playing" card.
const latest = [...episodes].sort((a, b) => (b.uploadDate || '').localeCompare(a.uploadDate || ''))[0];
const latestFull = full.find((e) => e.id === latest?.id);
const latestWave = speechWaveform(latestFull || latest, 56);
---

<Base path="/">
  <section class="hero">
    <div class="container hero-copy">
      <h1>Every FTC interview, searchable <span class="hl">to the second.</span></h1>
      <p class="lead">
        {site.name} is where {site.team} sits down with other teams to ask how they really built
        their robots. Ask anything, and get an answer linked to the exact moment it was said.
      </p>
    </div>

    {
      latest && (
        <div class="container">
          <a class="dock panel" href={`/episodes/${latest.id}/`}>
            <span class="dock-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20"><path d="M7 4.5v15l12-7.5z" fill="currentColor" /></svg>
            </span>
            <span class="dock-thumb">
              <img src={latest.thumbnail} alt="" width="480" height="270" />
            </span>
            <span class="dock-info">
              <span class="dock-kicker">
                Latest episode{teamFromTitle(latest.title) && ` · ${teamFromTitle(latest.title)}`}
              </span>
              <span class="dock-title">{latest.title}</span>
            </span>
            <span class="dock-wave">
              <Wave values={latestWave} class="now-wave" />
              <Wave values={latestWave} class="now-wave now-played" />
              <span class="now-head" aria-hidden="true"></span>
            </span>
            <span class="dock-dur">{humanDuration(latest.durationSeconds)}</span>
          </a>
        </div>
      )
    }

    <canvas class="scope" id="scope" aria-hidden="true"></canvas>

    <div class="container hero-ask">
      <AskPodcast autofocus={true} />
    </div>
  </section>

  <section class="container" aria-label="Archive at a glance">
    <div class="readouts" data-reveal>
      {
        readouts.map((r) => (
          <div class="readout">
            <strong data-count={r.value}>{r.value.toLocaleString('en-US')}</strong>
            <span>{r.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <h2>Latest episodes</h2>
        </div>
        <a class="arrow-link" href="/episodes/">All {episodes.length} episodes</a>
      </div>
      <ol class="tracklist">
        {featured.map((ep, i) => <EpisodeCard ep={ep} n={i + 1} />)}
      </ol>
      <p class="wave-note" data-reveal>
        Waveforms show how densely people are talking through each episode, drawn from the
        transcripts.
      </p>
    </div>
  </section>

  <section class="section chain-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <h2>How a question gets answered</h2>
          <p>
            The heavy lifting happens before the site goes live, so search is fast and the
            whole thing runs on free tiers.
          </p>
        </div>
      </div>
      <ol class="chain">
        <li class="node panel" data-reveal style="--i:0">
          <span class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg></span>
          <h3>Record</h3>
          <p>We interview a team about their robot, season, and lessons learned.</p>
        </li>
        <li class="node panel" data-reveal style="--i:1">
          <span class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 10h16M4 14h10M4 18h7"/></svg></span>
          <h3>Transcribe</h3>
          <p>Captions become a timestamped transcript, translated into {languages.length} more languages.</p>
        </li>
        <li class="node panel" data-reveal style="--i:2">
          <span class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg></span>
          <h3>Index</h3>
          <p>Each moment is indexed by meaning, so you can search for ideas, not just keywords.</p>
        </li>
        <li class="node panel" data-reveal style="--i:3">
          <span class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18.5V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8.5z"/></svg></span>
          <h3>Ask</h3>
          <p>Your question pulls the closest moments, and the answer cites every one.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container rules">
      <div class="section-head" data-reveal>
        <div>
          <h2>Guardrails that stay on</h2>
          <p>These switches are wired on. You can’t turn them off, and neither can the AI.</p>
        </div>
        <a class="arrow-link" href="/about/">How it works</a>
      </div>
      <ul class="switches">
        {
          [
            ['Archive only', 'If the episodes don’t cover it, the site says so instead of guessing.'],
            ['Show sources', 'Every answer links to the timestamp it came from.'],
            ['Verbatim quotes', 'Quotes are checked word for word against the transcript.'],
            ['Student safe', 'Everything is kept appropriate for a school audience.'],
          ].map(([t, d], i) => (
            <li class="switch panel" data-reveal style={`--i:${i}`}>
              <span class="toggle" aria-hidden="true"><span></span></span>
              <span>
                <strong>{t}</strong>
                <span class="muted">{d}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <style>
    /* ---------- hero: centered headline, signal into the Ask box, player dock ---------- */
    .hero {
      position: relative;
      padding-block: clamp(56px, 8vw, 104px) clamp(40px, 6vw, 72px);
      overflow: hidden;
    }
    .hero-copy {
      display: grid;
      gap: 24px;
      justify-items: center;
      text-align: center;
    }
    .hero h1 {
      max-width: 15ch;
      font-size: clamp(2.8rem, 7.4vw, 6.2rem);
    }
    .hl {
      color: var(--accent);
    }
    .hero .lead {
      margin: 0;
    }
    .scope {
      display: block;
      width: 100%;
      height: clamp(90px, 11vw, 140px);
      margin-top: clamp(12px, 2vw, 24px);
      pointer-events: none;
    }

    /* Latest episode as a media-player dock. */
    .dock {
      display: grid;
      grid-template-columns: 52px 112px minmax(0, 1fr) minmax(0, 1.3fr) auto;
      align-items: center;
      gap: 18px;
      margin: clamp(28px, 4vw, 44px) 0 0;
      padding: 12px 22px 12px 12px;
      border-radius: 999px;
      color: var(--text);
      text-decoration: none;
      transition: border-color 200ms ease, transform 260ms var(--ease);
    }
    .dock:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .dock-play {
      display: grid;
      place-items: center;
      width: 52px;
      height: 52px;
      border: 1.5px solid var(--accent);
      border-radius: 50%;
      color: var(--accent);
      transition: background-color 160ms ease, transform 220ms var(--ease);
    }
    .dock:hover .dock-play {
      background: var(--accent-soft);
      transform: scale(1.06);
    }
    .dock-thumb {
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: var(--r-sm);
      background: var(--panel-2);
    }
    .dock-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .dock-info {
      display: grid;
      gap: 4px;
      min-width: 0;
    }
    .dock-kicker {
      font-size: 0.85rem;
      color: var(--muted);
    }
    .dock-title {
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      font-family: var(--display);
      font-weight: 600;
      font-size: 1rem;
      line-height: 1.25;
      letter-spacing: -0.02em;
    }
    .dock-dur {
      font-family: var(--mono);
      font-size: 0.85rem;
      color: var(--muted);
    }
    /* Waveform with a playhead that sweeps across, lighting bars as it goes. */
    .dock-wave {
      position: relative;
    }
    .dock-wave :global(.now-wave) {
      height: 36px;
    }
    .dock-wave :global(.now-played) {
      position: absolute;
      inset: 0;
      clip-path: inset(0 100% 0 0);
      animation: reveal 6s linear infinite;
    }
    .dock-wave :global(.now-played i) {
      background: var(--accent-2);
    }
    @keyframes reveal {
      to {
        clip-path: inset(0 0 0 0);
      }
    }
    .now-head {
      position: absolute;
      top: -4px;
      bottom: -4px;
      left: 0;
      width: 2px;
      border-radius: 1px;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
      animation: sweep 6s linear infinite;
    }
    @keyframes sweep {
      from {
        left: 0;
      }
      to {
        left: 100%;
      }
    }
    @media (max-width: 860px) {
      .dock {
        grid-template-columns: 44px 96px minmax(0, 1fr);
        gap: 12px 14px;
        padding: 12px;
        border-radius: var(--r-lg);
      }
      .dock-play {
        width: 44px;
        height: 44px;
      }
      .dock-wave {
        grid-column: 1 / -1;
      }
      .dock-dur {
        display: none;
      }
    }

    .wave-note {
      margin: 18px 0 0;
      font-size: 0.85rem;
      color: var(--dim);
    }

    /* ---------- signal chain ---------- */
    .chain {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    /* The cable, with a pulse running down it. */
    .chain::before,
    .chain::after {
      content: '';
      position: absolute;
      top: 42px;
      height: 2px;
      left: 6%;
      right: 6%;
    }
    .chain::before {
      background: var(--line-2);
    }
    .chain::after {
      width: 80px;
      right: auto;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      animation: pulse-run 3.2s ease-in-out infinite;
    }
    @keyframes pulse-run {
      from {
        transform: translateX(0);
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      90% {
        opacity: 1;
      }
      to {
        transform: translateX(min(80vw, 1000px));
        opacity: 0;
      }
    }
    .node {
      position: relative;
      z-index: 1;
      padding: 22px 22px 24px;
      transition: border-color 200ms ease, transform 260ms var(--ease);
    }
    .node:hover {
      border-color: var(--accent-2);
      transform: translateY(-4px);
    }
    .node-icon {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      margin-bottom: 18px;
      border: 1.5px solid var(--accent);
      border-radius: 999px;
      background: var(--panel);
      color: var(--accent);
      transition: background-color 200ms ease;
    }
    .node:hover .node-icon {
      background: var(--accent-soft);
    }
    .node h3 {
      font-size: 1.35rem;
      margin-bottom: 8px;
    }
    .node p {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
    }

    /* ---------- guardrail switches ---------- */
    .switches {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .switch {
      display: flex;
      gap: 18px;
      align-items: flex-start;
      padding: 20px 22px;
    }
    .switch strong {
      display: block;
      margin-bottom: 4px;
      font-family: var(--display);
      font-size: 1.1rem;
      letter-spacing: -0.02em;
    }
    .switch .muted {
      font-size: 0.95rem;
    }
    .toggle {
      flex: none;
      position: relative;
      width: 44px;
      height: 24px;
      margin-top: 2px;
      border-radius: 999px;
      background: var(--accent);
      box-shadow: 0 0 14px var(--glow);
    }
    .toggle span {
      position: absolute;
      top: 3px;
      right: 3px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #fff;
    }
    .switch:hover .toggle span {
      animation: nope 420ms var(--ease);
    }
    /* Tries to switch off, snaps back on. */
    @keyframes nope {
      40% {
        transform: translateX(-9px);
      }
    }

    @media (max-width: 900px) {
      .chain {
        grid-template-columns: 1fr 1fr;
      }
      .chain::before,
      .chain::after {
        display: none;
      }
    }
    @media (max-width: 600px) {
      .chain,
      .switches {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // Oscilloscope behind the hero. A few layered traces idle quietly, swell
    // around the cursor, kick on every keystroke in the Ask box, and run hot
    // while a question is being answered.
    const canvas = document.getElementById('scope');
    const ctx = canvas?.getContext('2d');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas && ctx) {
      let w = 0;
      let h = 0;
      let energy = 0;
      let busy = false;
      let frame = 0;
      let visible = true;
      const pointer = { x: -1, y: -1, active: 0 };

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width;
        h = r.height;
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const traces = [
        { tone: '--accent-2', alpha: 0.22, amp: 0.9, freq: 0.009, speed: 0.6, phase: 0, width: 1 },
        { tone: '--accent-2', alpha: 0.4, amp: 0.6, freq: 0.016, speed: -0.9, phase: 2, width: 1 },
        { tone: '--accent', alpha: 0.75, amp: 1, freq: 0.012, speed: 1.2, phase: 4, width: 1.6 },
      ];
      // Trace colors come from the theme's CSS variables (hex), re-read on toggle.
      const rgba = (hex, a) => {
        const n = parseInt(hex.trim().replace('#', ''), 16);
        return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
      };
      const paint = () => {
        const css = getComputedStyle(document.documentElement);
        traces.forEach((tr) => (tr.color = rgba(css.getPropertyValue(tr.tone), tr.alpha)));
      };
      paint();
      window.addEventListener('themechange', () => {
        paint();
        if (still) draw(0);
      });

      const draw = (t) => {
        ctx.clearRect(0, 0, w, h);
        const mid = h * 0.5;
        const base = 8 + energy * 30 + (busy ? 18 : 0);
        for (const tr of traces) {
          ctx.beginPath();
          ctx.strokeStyle = tr.color;
          ctx.lineWidth = tr.width;
          for (let x = 0; x <= w; x += 3) {
            // Bump in amplitude around the cursor (a gaussian bell).
            const near = pointer.active * Math.exp(-Math.pow((x - pointer.x) / 140, 2));
            const amp = (base + near * 34) * tr.amp;
            // Fade the trace out toward both edges.
            const edge = Math.sin((x / w) * Math.PI);
            const y =
              mid +
              Math.sin(x * tr.freq + t * 0.001 * tr.speed * 3 + tr.phase) * amp * edge * 0.6 +
              Math.sin(x * tr.freq * 2.7 - t * 0.002 * tr.speed + tr.phase) * amp * edge * 0.4;
            x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
          }
          ctx.stroke();
        }
        energy *= 0.94;
        pointer.active *= pointer.x < 0 ? 0.9 : 1;
      };

      const loop = (t) => {
        draw(t);
        frame = requestAnimationFrame(loop);
      };
      const sync = () => {
        cancelAnimationFrame(frame);
        if (still) draw(0);
        else if (visible && !document.hidden) frame = requestAnimationFrame(loop);
      };

      resize();
      sync();
      window.addEventListener('resize', () => {
        resize();
        if (still) draw(0);
      }, { passive: true });
      document.addEventListener('visibilitychange', sync);
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        sync();
      }).observe(canvas);

      window.addEventListener('ask:keystroke', () => (energy = Math.min(1, energy + 0.35)));
      window.addEventListener('ask:busy', () => (busy = true));
      window.addEventListener('ask:idle', () => {
        busy = false;
        energy = 1;
      });

      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (fine && !still) {
        canvas.closest('.hero').addEventListener('pointermove', (e) => {
          const r = canvas.getBoundingClientRect();
          pointer.x = e.clientX - r.left;
          pointer.y = e.clientY - r.top;
          pointer.active = Math.min(1, pointer.active + 0.08);
        }, { passive: true });
        canvas.closest('.hero').addEventListener('pointerleave', () => (pointer.x = -1));
      }
    }
  </script>
</Base>
